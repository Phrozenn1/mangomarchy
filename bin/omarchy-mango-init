#!/bin/bash
# omarchy-mango-init: Initialize or refresh user-space MangoWC configs and
# Omarchy theme integration (~/.config/mango, ~/.config/omarchy/themed).

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

if [[ -d $REPO_ROOT/share/default/mango ]]; then
  SHARE_DIR="$REPO_ROOT/share"
  LIB_BIN_DIR="$REPO_ROOT/lib/bin"
elif [[ -d /usr/share/omarchy-mango/default/mango ]]; then
  SHARE_DIR="/usr/share/omarchy-mango"
  LIB_BIN_DIR="/usr/lib/omarchy-mango/bin"
else
  echo "Error: Could not locate omarchy-mango share directory." >&2
  exit 1
fi

MODE="ensure"
for arg in "$@"; do
  case "$arg" in
    --ensure) MODE="ensure" ;;
    --force|--reset) MODE="force" ;;
    -h|--help)
      cat <<USAGE
Usage: omarchy-mango-init [--ensure | --force]

Options:
  --ensure  Create missing ~/.config/mango files and theme templates without
            overwriting existing user customizations (default).
  --force   Backup and reset ~/.config/mango files to Omarchy MangoWC defaults.
USAGE
      exit 0
      ;;
  esac
done

USER_SHARE_LINK="$HOME/.local/share/omarchy-mango"
MANGO_CONFIG_DIR="$HOME/.config/mango"
USER_THEMED_DIR="$HOME/.config/omarchy/themed"
CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"
HOOKS_DIR="$HOME/.config/omarchy/hooks/theme-set.d"

mkdir -p "$(dirname "$USER_SHARE_LINK")" "$MANGO_CONFIG_DIR" "$USER_THEMED_DIR" "$HOOKS_DIR"

# 1. Point ~/.local/share/omarchy-mango at the active share directory
ln -snf "$SHARE_DIR" "$USER_SHARE_LINK"
mkdir -p "$HOME/.local/state/omarchy"
ln -snf "$LIB_BIN_DIR" "$HOME/.local/state/omarchy/mango-lib-bin"

# 2. Populate ~/.config/mango/
ts=$(date +%Y%m%d%H%M%S)
for file in config.conf monitors.conf input.conf looknfeel.conf bindings.conf; do
  src="$SHARE_DIR/config/mango/$file"
  dst="$MANGO_CONFIG_DIR/$file"
  if [[ ! -f $dst ]]; then
    cp "$src" "$dst"
  elif [[ $MODE == "force" ]]; then
    cp "$dst" "${dst}.bak.${ts}"
    cp "$src" "$dst"
  fi
done

# 3. Install dynamic theme template into ~/.config/omarchy/themed/
cp "$SHARE_DIR/themed/mango-theme.conf.tpl" "$USER_THEMED_DIR/mango-theme.conf.tpl"

# 4. Render mango-theme.conf immediately for the currently active Omarchy theme
render_current_theme() {
  local colors_file="$CURRENT_THEME_DIR/colors.toml"
  local out_file="$CURRENT_THEME_DIR/mango-theme.conf"
  [[ -d $CURRENT_THEME_DIR ]] || return 0

  local bg="1a1b26" fg="c0caf5" accent="7aa2f7" red="f7768e"
  if [[ -f $colors_file ]] && command -v omarchy-theme-color >/dev/null 2>&1; then
    bg=$(omarchy-theme-color --file "$colors_file" background 2>/dev/null | tr -d '#' || echo "1a1b26")
    fg=$(omarchy-theme-color --file "$colors_file" foreground 2>/dev/null | tr -d '#' || echo "c0caf5")
    accent=$(omarchy-theme-color --file "$colors_file" accent 2>/dev/null | tr -d '#' || echo "7aa2f7")
    red=$(omarchy-theme-color --file "$colors_file" red 2>/dev/null | tr -d '#' || echo "f7768e")
  fi

  cat >"$out_file" <<EOF
# Generated by Omarchy Theme Engine for MangoWC (mangowm 0.18+)
root_color=0x${bg}ff
border_color=0x${fg}59
focus_color=0x${accent}ff
urgent_color=0x${red}ff
EOF
}
render_current_theme

# 5. Install theme-set hook to reload MangoWC whenever `omarchy theme set` runs
cat >"$HOOKS_DIR/50-mango-reload.sh" <<'EOF'
#!/bin/bash
if [[ -n ${MANGO_INSTANCE_SIGNATURE:-} ]] || pgrep -x mango >/dev/null 2>&1; then
  mmsg dispatch reload_config >/dev/null 2>&1 || true
fi
EOF
chmod +x "$HOOKS_DIR/50-mango-reload.sh"
